                <img data-stretch="false" data-image="https://images.squarespace-cdn.com/content/v1/62f2a61a63fd070566a92dd6/1669175467220-FUVCQ9ZL276FH41QJEGD/Header-MonsterHigh.jpg" data-image-dimensions="1030x520" data-image-focal-point="0.5,0.5" alt="" data-load="false" elementtiming="system-image-block" data-sqsp-image-classic-block-image src="https://images.squarespace-cdn.com/content/v1/62f2a61a63fd070566a92dd6/1669175467220-FUVCQ9ZL276FH41QJEGD/Header-MonsterHigh.jpg?format=1000w" width="1030" height="520" sizes="(max-width: 640px) 100vw, (max-width: 767px) 100vw, 100vw" onload="this.classList.add(&quot;loaded&quot;)" srcset="https://images.squarespace-cdn.com/content/v1/62f2a61a63fd070566a92dd6/1669175467220-FUVCQ9ZL276FH41QJEGD/Header-MonsterHigh.jpg?format=100w 100w, https://images.squarespace-cdn.com/content/v1/62f2a61a63fd070566a92dd6/1669175467220-FUVCQ9ZL276FH41QJEGD/Header-MonsterHigh.jpg?format=300w 300w, https://images.squarespace-cdn.com/content/v1/62f2a61a63fd070566a92dd6/1669175467220-FUVCQ9ZL276FH41QJEGD/Header-MonsterHigh.jpg?format=500w 500w, https://images.squarespace-cdn.com/content/v1/62f2a61a63fd070566a92dd6/1669175467220-FUVCQ9ZL276FH41QJEGD/Header-MonsterHigh.jpg?format=750w 750w, https://images.squarespace-cdn.com/content/v1/62f2a61a63fd070566a92dd6/1669175467220-FUVCQ9ZL276FH41QJEGD/Header-MonsterHigh.jpg?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/62f2a61a63fd070566a92dd6/1669175467220-FUVCQ9ZL276FH41QJEGD/Header-MonsterHigh.jpg?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/62f2a61a63fd070566a92dd6/1669175467220-FUVCQ9ZL276FH41QJEGD/Header-MonsterHigh.jpg?format=2500w 2500w" loading="lazy" decoding="async" data-loader="sqs">

            
          
        
          
        

        
      
